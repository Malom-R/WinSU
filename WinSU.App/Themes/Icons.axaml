<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Icônes des styles de menu (M15, M16) : glyphes simples dessinés pour WinSU, en traits sur un carré de 24 × 24 (style
    Path.icon de Themes/Switch.axaml, relief de Themes/WiiU.axaml), pas ceux des consoles ni du site (D-22).
  -->
  <StreamGeometry x:Key="WinSU.IconGear">M 19.15,10.08 L 22.09,10.49 L 22.09,13.51 L 19.15,13.92 L 18.41,15.70 L 20.20,18.07 L 18.07,20.20 L 15.70,18.41 L 13.92,19.15 L 13.51,22.09 L 10.49,22.09 L 10.08,19.15 L 8.30,18.41 L 5.93,20.20 L 3.80,18.07 L 5.59,15.70 L 4.85,13.92 L 1.91,13.51 L 1.91,10.49 L 4.85,10.08 L 5.59,8.30 L 3.80,5.93 L 5.93,3.80 L 8.30,5.59 L 10.08,4.85 L 10.49,1.91 L 13.51,1.91 L 13.92,4.85 L 15.70,5.59 L 18.07,3.80 L 20.20,5.93 L 18.41,8.30 Z M 15.2,12 A 3.2,3.2 0 1 1 8.8,12 A 3.2,3.2 0 1 1 15.2,12 Z</StreamGeometry>
